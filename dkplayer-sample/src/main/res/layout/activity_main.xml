<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- 顶部操作栏：输入框 + 解析 + 切电脑UA + 记录 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E9E9E9"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_url"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="粘贴直播间链接或分享文"
            android:textColorHint="#888888"
            android:textColor="#222222"
            android:background="#B3AEB5"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="13sp"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/btn_parse"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="解析"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#F2A7B3"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginLeft="8dp"/>

        <TextView
            android:id="@+id/btn_ua"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="切电脑UA"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#A9D9B8"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginLeft="8dp"/>

        <TextView
            android:id="@+id/btn_records"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="记录"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#F2A7B3"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <!-- 底部固定记录面板（默认隐藏，点"记录"显示） -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC191a3e"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/scroll_records"
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <LinearLayout
                android:id="@+id/layout_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- 底部栏：功能大全 + 播放器 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#E9E9E9">

        <TextView
            android:id="@+id/btn_features"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="功能大全"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#F2A7B3"
            android:layout_margin="6dp"/>

        <TextView
            android:id="@+id/btn_player"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="播放器"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="#A9D9B8"
            android:layout_margin="6dp"/>
    </LinearLayout>

    <!-- 右下角悬浮球：点击切换顶部栏显示/隐藏 -->
    <FrameLayout
        android:id="@+id/btn_toggle_top"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/fab_circle"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="≡"
            android:textColor="#ffffff"
            android:textSize="20sp"/>
    </FrameLayout>

</FrameLayout>
