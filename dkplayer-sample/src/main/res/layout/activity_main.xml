<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f0f23">

    <!-- 顶部浮动操作栏：输入框 + 回车按钮 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#190f0f23"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_url"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="粘贴视频链接"
            android:textColorHint="#666666"
            android:textColor="#ffffff"
            android:background="#4D1e1e3f"
            android:padding="8dp"
            android:textSize="13sp"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:gravity="center_vertical"/>

        <Button
            android:id="@+id/btn_go"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="→"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:background="#4D2ed573"
            android:layout_marginLeft="8dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>

    <!-- 媒体管理面板（默认隐藏） -->
    <LinearLayout
        android:id="@+id/media_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#191a1a3e"
        android:visibility="gone"
        android:paddingBottom="56dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本机视频"
            android:textColor="#88ffffff"
            android:textSize="12sp"
            android:padding="8dp"/>

        <ListView
            android:id="@+id/list_media"
            android:layout_width="match_parent"
            android:layout_height="260dp"/>
    </LinearLayout>

    <!-- 底部栏：功能大全 / 媒体管理 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#190f0f23">

        <Button
            android:id="@+id/btn_features"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="功能大全"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:background="#4D1e1e3f"
            android:minWidth="0dp"
            android:minHeight="0dp"/>

        <Button
            android:id="@+id/btn_media"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:text="媒体管理"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:background="#4D1e1e3f"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>

</FrameLayout>
